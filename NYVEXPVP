        animConnection = nil
    end

    animConnection = RunService.RenderStepped:Connect(function()
        if not isSlayActive or not character or not character.Parent or humanoid.Health <= 0 then
            stopAllTracks()
            if animateScript then animateScript.Disabled = false end
            return
        end

        -- ปิด Animate เดิมของเกมไม่ให้อนิเมชั่นตีกัน
        if animateScript then animateScript.Disabled = true end

        local state = humanoid:GetState()
        local isJumpingOrFreefall = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)
        local isMoving = humanoid.MoveDirection.Magnitude > 0.1

        if isJumpingOrFreefall then
            -- 1. ขณะกระโดด / ร่วงตกจากที่สูง -> เล่นท่า Jump Spin Animation
            if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.1) end
            if walkTrack and walkTrack.IsPlaying then walkTrack:Stop(0.1) end

            if not jumpTrack and REAL_JUMP_ID then
                local anim = Instance.new("Animation")
                anim.AnimationId = REAL_JUMP_ID
                local success, track = pcall(function() return animator:LoadAnimation(anim) end)
                if success and track then
                    jumpTrack = track
                    jumpTrack.Priority = Enum.AnimationPriority.Action4
                    jumpTrack.Looped = true
                    jumpTrack:Play(0.1)
                end
            elseif jumpTrack and not jumpTrack.IsPlaying then
                jumpTrack:Play(0.1)
            end

        elseif isMoving then
            -- 2. ขณะเดิน / วิ่ง -> เล่นท่า Queen Runway Model
            if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.1) end
            if jumpTrack and jumpTrack.IsPlaying then jumpTrack:Stop(0.1) end

            if not walkTrack and REAL_WALK_ID then
                local anim = Instance.new("Animation")
                anim.AnimationId = REAL_WALK_ID
                local success, track = pcall(function() return animator:LoadAnimation(anim) end)
                if success and track then
                    walkTrack = track
                    walkTrack.Priority = Enum.AnimationPriority.Action4
                    walkTrack.Looped = true
                    walkTrack:Play(0.1)
                    walkTrack:AdjustSpeed(1.15)
                end
            elseif walkTrack and not walkTrack.IsPlaying then
                walkTrack:Play(0.1)
            end

        else
            -- 3. หยุดยืนนิ่ง -> เล่นท่า TWICE - The Feels
            if walkTrack and walkTrack.IsPlaying then walkTrack:Stop(0.1) end
            if jumpTrack and jumpTrack.IsPlaying then jumpTrack:Stop(0.1) end

            if not idleTrack and REAL_IDLE_ID then
                local anim = Instance.new("Animation")
                anim.AnimationId = REAL_IDLE_ID
                local success, track = pcall(function() return animator:LoadAnimation(anim) end)
                if success and track then
                    idleTrack = track
                    idleTrack.Priority = Enum.AnimationPriority.Action4
                    idleTrack.Looped = true
                    idleTrack:Play(0.1)
                end
            elseif idleTrack and not idleTrack.IsPlaying then
                idleTrack:Play(0.1)
            end
        end
    end)
end

