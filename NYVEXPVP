-- ฟังก์ชันดึง Real Animation ID จาก Catalog
local function getRealAnimationId(catalogId)
    local animId = nil
    pcall(function()
        local asset = game:GetObjects("rbxassetid://" .. tostring(catalogId))[1]
        if asset then
            if asset:IsA("Animation") then
                animId = asset.AnimationId
            else
                for _, v in ipairs(asset:GetDescendants()) do
                    if v:IsA("Animation") then
                        animId = v.AnimationId
                        break
                    end
                end
            end
            asset:Destroy()
        end
    end)
    return animId or ("rbxassetid://" .. tostring(catalogId))
end

