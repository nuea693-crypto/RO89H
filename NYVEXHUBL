end

local function INV_BuildGUI(player)
    if not inventoryESPEnabled or player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if localRoot and (root.Position - localRoot.Position).Magnitude > INV_MAX_DIST then
        INV_DestroyGUI(player); return
    end

    local gui = root:FindFirstChild("ItemBillboard")
    if not gui then
        gui = Instance.new("BillboardGui")
        gui.Name = "ItemBillboard"
        gui.AlwaysOnTop = true
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.Size = UDim2.fromOffset(150, 40)
        gui.StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0)
        gui.LightInfluence = 0
        gui.MaxDistance = math.huge
        gui.Parent = root
        local bg = Instance.new("Frame")
        bg.Name = "BG"
        bg.BackgroundTransparency = 1
        bg.Size = UDim2.fromOffset(150, 40)
        bg.Parent = gui
        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.Padding = UDim.new(0, 4)
        layout.Parent = bg
    end

    gui.Enabled = true
    local bg = gui:FindFirstChild("BG")
    if not bg then return end

    local activeItems = {}
    for _, container in pairs({ player:FindFirstChild("Backpack"), player.Character }) do
        if container then
            for _, tool in pairs(container:GetChildren()) do
                if tool:IsA("Tool") and not tool:GetAttribute("JobTool") and not tool:GetAttribute("Locked") then
                    local itemData = INV_ResolveData(tool)
                    if itemData and itemData.ImageId then
                        local iName = itemData.Name
                        activeItems[iName] = true
                        if not bg:FindFirstChild(iName .. "_bg") then
                            local rarityColor = INV_RarityColor(itemData.Rarity)
                            local itemContainer = Instance.new("Frame")
                            itemContainer.Name = iName .. "_bg"
                            itemContainer.Size = UDim2.fromOffset(20, 20)
                            itemContainer.BackgroundTransparency = 1
                            itemContainer.BorderSizePixel = 0
                            itemContainer.Parent = bg
                            local iconBg = Instance.new("Frame")
                            iconBg.Name = "IconBg"
                            iconBg.Size = UDim2.fromOffset(20, 20)
                            iconBg.BackgroundColor3 = rarityColor
                            iconBg.BackgroundTransparency = 0.5
                            iconBg.BorderSizePixel = 0
                            iconBg.Parent = itemContainer
                            local corner = Instance.new("UICorner")
                            corner.CornerRadius = UDim.new(0.15, 0)
                            corner.Parent = iconBg
                            local icon = Instance.new("ImageLabel")
                            icon.Name = iName
                            icon.Image = itemData.ImageId
                            icon.BackgroundTransparency = 1
                            icon.BorderSizePixel = 0
                            icon.Size = UDim2.fromOffset(16, 16)
                            icon.Position = UDim2.fromOffset(2, 2)
                            icon.Parent = iconBg
                            local corner2 = Instance.new("UICorner")
                            corner2.CornerRadius = UDim.new(0, 5)
                            corner2.Parent = icon
                        end
                    end
                end
            end
        end
    end

    for _, child in pairs(bg:GetChildren()) do
        if child:IsA("Frame") then
            local iName = child.Name:gsub("_bg$", "")
            if not activeItems[iName] then child:Destroy() end
        end
    end
end

local function INV_SetupPlayer(player)
    if player == LocalPlayer then return end
    local conns = {}
    local function onChanged()
        if inventoryESPEnabled then INV_BuildGUI(player) end
    end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        table.insert(conns, bp.ChildAdded:Connect(onChanged))
        table.insert(conns, bp.ChildRemoved:Connect(onChanged))
    end
    table.insert(conns, player.CharacterAdded:Connect(function(char)
        bp = player:FindFirstChild("Backpack")
        if bp then
            table.insert(conns, bp.ChildAdded:Connect(onChanged))
            table.insert(conns, bp.ChildRemoved:Connect(onChanged))
        end
        char.ChildAdded:Connect(onChanged)
        char.ChildRemoved:Connect(onChanged)
        if inventoryESPEnabled then task.wait(); INV_BuildGUI(player) end
    end))
    if player.Character then
        local char = player.Character
        table.insert(conns, char.ChildAdded:Connect(onChanged))
        table.insert(conns, char.ChildRemoved:Connect(onChanged))
    end
    inventoryConnections[player] = conns
end

local function INV_TeardownPlayer(player)
    local conns = inventoryConnections[player]
    if conns then for _, c in pairs(conns) do c:Disconnect() end end
    inventoryConnections[player] = nil
    INV_DestroyGUI(player)
end

