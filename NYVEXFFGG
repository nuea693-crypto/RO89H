            pcall(function() require(ReplicatedStorage.Modules.Game.CharacterCreator.CharacterCreator) end)
            pcall(function() require(ReplicatedStorage.Modules.Core.Char) end)

            if not _Net then
                pcall(function() _Net = require(ReplicatedStorage.Modules.Core.Net) end)
            end

            if _Net then
                if not _G.Bypass then
                    pcall(function()
                        local func = getupvalue and getupvalue(_Net.get, 2)
                        if func and setconstant then
                            setconstant(func, 3, "KUYIENGOKUYIENGO")
                            setconstant(func, 4, "KUYIENGOKUYIENGO")
                        end
                    end)
                    _G.Bypass = true
                end

                pcall(function()
                    if hookfunction then
                        local old
                        old = hookfunction(_Net.send, function(...)
                            local d = {...}
                            if d[1] == "leave_character_creator" or d[1] == "player_created_outfit" then
                                return nil
                            end
                            return old(...)
                        end)
                    end
                end)
            end

            task.wait(2.5)
            local splashGui = PlayerGui:FindFirstChild("SplashScreenGui")
            if splashGui then
                local frame = splashGui:FindFirstChild("Frame")
                local playBtn = frame and frame:FindFirstChild("PlayButton")
                if playBtn then
                    pcall(function() firesignal(playBtn.MouseButton1Click) end)
                    pcall(function() firesignal(playBtn.Activated) end)
                end
            end

            task.wait(4)
            local characterCreator = PlayerGui:FindFirstChild("CharacterCreator")
            if characterCreator then
                local menuFrame = characterCreator:FindFirstChild("MenuFrame")
                local skipBtn = menuFrame and menuFrame:FindFirstChild("AvatarMenuSkipButton")
                if skipBtn then
                    pcall(function() firesignal(skipBtn.MouseButton1Click) end)
                    pcall(function() firesignal(skipBtn.Activated) end)
                end
            end

            task.wait(2.5)
            pcall(function()
                local repSig = replicatesignal or firesignal
                if repSig then
                    repSig(Players.LocalPlayer.Kill)
                end
            end)
            task.wait(7)
            if _Net then
                pcall(function() _Net.send("death_screen_request_respawn") end)
            else
                pcall(function()
                    ReplicatedStorage.Remotes.Send:FireServer("death_screen_request_respawn")
                end)
            end
        end)

        -- 2. โหลดสคริปต์หลัก PVP (NYVEXPVP) ขึ้นมาทำงานพร้อมกัน
        task.spawn(function()
            task.wait(3)
            loadstring(game:HttpGet("https://raw.githubusercontent.com/nuea693-crypto/RO89H/main/NYVEXPVP"))()
        end)
    end)

    print("[NYVEXHUB] Mode Selector Loaded Successfully!")
end

